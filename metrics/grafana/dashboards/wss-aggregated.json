{
  "id": null,
  "uid": "wss-aggregated",
  "title": "WSS Aggregated Metrics",
  "tags": ["wss", "aggregated"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 4,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Active Connections",
      "gridPos": {"x": 0, "y": 0, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_active_connections)", "legendFormat": "Connections"}]
    },
    {
      "type": "stat",
      "title": "Active Rooms",
      "gridPos": {"x": 3, "y": 0, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_active_rooms)", "legendFormat": "Rooms"}]
    },
    {
      "type": "stat",
      "title": "Msgs / sec",
      "gridPos": {"x": 6, "y": 0, "w": 3, "h": 3},
      "targets": [{"expr": "sum(rate(wss_messages_total[1m]))", "legendFormat": "Messages/sec"}]
    },
    {
      "type": "stat",
      "title": "Avg Latency (ms)",
      "gridPos": {"x": 9, "y": 0, "w": 3, "h": 3},
      "targets": [{
        "expr": "sum(rate(wss_latency_ms_sum[5m])) / sum(rate(wss_latency_ms_count[5m]))",
        "legendFormat": "Latency ms"
      }]
    },
    {
      "type": "stat",
      "title": "Direct Messages",
      "gridPos": {"x": 0, "y": 3, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_direct_messages_total)", "legendFormat": "Direct"}]
    },
    {
      "type": "stat",
      "title": "Room Messages",
      "gridPos": {"x": 3, "y": 3, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_room_messages_total)", "legendFormat": "Room"}]
    },
    {
      "type": "stat",
      "title": "Messages Delivered",
      "gridPos": {"x": 6, "y": 3, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_messages_delivered_total)", "legendFormat": "Delivered"}]
    },
    {
      "type": "stat",
      "title": "Unexpected Disconnects",
      "gridPos": {"x": 9, "y": 3, "w": 3, "h": 3},
      "targets": [{"expr": "sum(wss_unexpected_disconnects_total)", "legendFormat": "Disconnects"}]
    },
    {
      "type": "timeseries",
      "title": "Connections Over Time",
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 6},
      "targets": [{"expr": "sum(wss_active_connections)", "legendFormat": "Connections"}]
    },
    {
      "type": "timeseries",
      "title": "Rooms Over Time",
      "gridPos": {"x": 6, "y": 6, "w": 6, "h": 6},
      "targets": [{"expr": "sum(wss_active_rooms)", "legendFormat": "Rooms"}]
    },
    {
      "type": "timeseries",
      "title": "Message Throughput",
      "gridPos": {"x": 0, "y": 12, "w": 6, "h": 6},
      "targets": [
        {"expr": "sum(rate(wss_direct_messages_total[1m]))", "legendFormat": "Direct/sec"},
        {"expr": "sum(rate(wss_room_messages_total[1m]))", "legendFormat": "Room/sec"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Room Join / Leave Activity",
      "gridPos": {"x": 6, "y": 12, "w": 6, "h": 6},
      "targets": [
        {"expr": "sum(rate(wss_room_joins_total[5m]))", "legendFormat": "Joins/sec"},
        {"expr": "sum(rate(wss_room_leaves_total[5m]))", "legendFormat": "Leaves/sec"}
      ]
    }
  ]
}
