{
  "id": null,
  "uid": "wss-replica",
  "title": "WSS Replica Metrics",
  "tags": ["wss", "replica"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 4,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Connections by Server",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 3},
      "targets": [{"expr": "wss_active_connections", "legendFormat": "{{server_id}}"}]
    },
    {
      "type": "stat",
      "title": "Rooms by Server",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 3},
      "targets": [{"expr": "wss_active_rooms", "legendFormat": "{{server_id}}"}]
    },
    {
      "type": "stat",
      "title": "Delivered by Server",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 3},
      "targets": [{"expr": "wss_messages_delivered_total", "legendFormat": "{{server_id}}"}]
    },
    {
      "type": "timeseries",
      "title": "Message Throughput by Server",
      "gridPos": {"x": 0, "y": 3, "w": 6, "h": 6},
      "targets": [
        {"expr": "rate(wss_direct_messages_total[1m])", "legendFormat": "{{server_id}} direct"},
        {"expr": "rate(wss_room_messages_total[1m])", "legendFormat": "{{server_id}} room"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Unexpected Disconnects by Server",
      "gridPos": {"x": 6, "y": 3, "w": 6, "h": 6},
      "targets": [{"expr": "rate(wss_unexpected_disconnects_total[5m])", "legendFormat": "{{server_id}}"}]
    },
    {
      "type": "timeseries",
      "title": "Room Activity by Server",
      "gridPos": {"x": 0, "y": 9, "w": 6, "h": 6},
      "targets": [
        {"expr": "rate(wss_room_joins_total[5m])", "legendFormat": "{{server_id}} joins"},
        {"expr": "rate(wss_room_leaves_total[5m])", "legendFormat": "{{server_id}} leaves"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency by Server (ms)",
      "gridPos": {"x": 6, "y": 9, "w": 6, "h": 6},
      "targets": [{
        "expr": "rate(wss_latency_ms_sum[5m]) / rate(wss_latency_ms_count[5m])",
        "legendFormat": "{{server_id}}"
      }]
    }
  ]
}
